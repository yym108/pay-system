# 本地演示值。复制为 deploy/.env 后按需修改；不要提交 deploy/.env。
# 验证可以不复制：make up ENV_FILE=deploy/.env.example

# compose 插值。应用进程不使用 root；最小权限账号由 BASE-03 创建。
MYSQL_ROOT_PASSWORD=dev-root-not-for-production

# BASE-03。svc_account / svc_payment 的口令写在下面的 DSN 里，不要另写一份。
# MYSQL_HOST 不写在这里：宿主机脚本默认 127.0.0.1，容器内由 compose 设为 mysql。
MYSQL_RECON_PASSWORD=dev-recon-not-for-production
MYSQL_CHANNEL_MOCK_PASSWORD=dev-channel-mock-not-for-production
MYSQL_MIGRATOR_PASSWORD=dev-migrator-not-for-production
# seed 与 merchant-demo 共用。%s 为商户号。merchant-demo 不另设密钥。
DEMO_APP_SECRET_FORMAT=demo_secret_%s_0123456789ab
# 1 时额外创建 M200000–M200099 压测商户，不入账。make seed-load 会自动设为 1。
SEED_LOAD=0

# 以下为 docs/03-conventions.md §8 的演示值。BASE-02 不启动应用，这些变量尚未被进程读取。
WORKER_ID=1
MYSQL_DSN=svc_payment:dev-payment-not-for-production@tcp(mysql:3306)/pay_payment?parseTime=true&loc=Asia%2FShanghai&charset=utf8mb4
ACCOUNT_DB_DSN_0=svc_account:dev-account-not-for-production@tcp(mysql:3306)/pay_account_0?parseTime=true&loc=Asia%2FShanghai&charset=utf8mb4
ACCOUNT_DB_DSN_1=svc_account:dev-account-not-for-production@tcp(mysql:3306)/pay_account_1?parseTime=true&loc=Asia%2FShanghai&charset=utf8mb4
ACCOUNT_SHARD_COUNT=2
PLATFORM_SUB_ACCOUNTS=8
LEDGER_BATCH_ENABLED=true
LEDGER_BATCH_SIZE=100
TRANSFER_PARALLEL_BRANCH=true
TRANSFER_RECOVER_DELAY=10s
TRANSFER_RECOVER_INTERVAL=1s
GW_CREDENTIAL_CACHE_TTL=60s
MERCHANT_CONFIG_CACHE_TTL=60s
REDIS_ADDR=redis:6379
KAFKA_BROKERS=kafka:9092
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317
# 空表示 parentbased_always_on。不认识的名字会让进程启动失败。
OTEL_TRACES_SAMPLER=
OTEL_TRACES_SAMPLER_ARG=
# 32 字节全 0 的 base64，仅演示。
SECRET_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
CHANNEL_MOCKPAY_KEY=dev-mockpay-key-not-for-production
CHANNEL_MOCKPAY_URL=http://channel-mock:9080
CHANNEL_NOTIFY_URL=http://gateway:8080/callback/mockpay
ADMIN_TOKEN=dev-admin-token-not-for-production-00
NOTIFY_URL_ALLOW_HOSTS=merchant-demo
RATE_LIMIT_DEFAULT=100:200
RATE_LIMIT_OVERRIDES=
QUERY_BACKOFF=10s,10s,30s,1m,2m,5m,10m,30m
NOTIFY_RETRY_INTERVAL=30s
NOTIFY_MAX_ATTEMPTS=5
RECON_RUN_AT=10:00
MOCK_DELAY_MIN_MS=200
MOCK_DELAY_MAX_MS=2000
MOCK_ALLOW_PARTIAL_BILL=false
FAULT_POINTS=
FAIL_FIRST_N=0
# TL-01 paycli。占位符，不是真实密钥。管理命令把网关地址指到管理端口（本地 :8090）。
PAYCLI_GATEWAY_URL=http://127.0.0.1:8080
PAYCLI_APP_ID=app_demo
PAYCLI_APP_SECRET=dev-app-secret-not-for-production
PAYCLI_ADMIN_TOKEN=dev-paycli-admin-token-not-for-production
